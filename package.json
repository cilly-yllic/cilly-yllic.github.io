{
  "name": "cilly-yllic-portfolio",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint",
    "format": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx,js,jsx,mjs,cjs}' '*.{mjs,cjs,ts}'",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx,js,jsx,mjs,cjs}' '*.{mjs,cjs,ts}'",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "mermaid": {
      "katex": "^0.18.2"
    }
  }
